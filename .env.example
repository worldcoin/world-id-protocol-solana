# Copy to .env and fill in, then run ./scripts/deploy.sh with no arguments.
# scripts/deploy.sh sources this file, so every value below controls the
# build -> deploy -> IDL push -> initialize -> add-gateway pipeline.

# ---------------------------------------------------------------------------
# Cluster + keys
# ---------------------------------------------------------------------------

# Solana cluster RPC URL. Use a moniker (devnet/testnet/mainnet-beta) or a
# full RPC URL (e.g. an Alchemy/Helius endpoint) for mainnet.
SOLANA_RPC_URL=devnet

# Path to the upgrade-authority keypair (JSON array format, e.g. from
# `solana-keygen new`). Pays for and signs every step below: deploy, IDL
# push, initialize, and add-gateway. Never commit this file or point it at
# a real mainnet authority's keypair from a shared machine.
SOLANA_AUTHORITY_KEYPAIR=$HOME/.config/solana/id.json

# Path to the program's own keypair (determines the program id on first
# deploy). Required only for a first deploy; leave unset for upgrades of an
# already-deployed program (deploy.sh then targets PROGRAM_ID instead).
SOLANA_PROGRAM_KEYPAIR=

# Overrides the target program id. Defaults to the workspace satellite
# program id (`declare_id!` in programs/world-id-solana/src/lib.rs) if unset,
# or to the pubkey of SOLANA_PROGRAM_KEYPAIR on a first deploy.
PROGRAM_ID=

# ---------------------------------------------------------------------------
# initialize (first deploy only; skipped automatically on repeat runs)
# ---------------------------------------------------------------------------

# Satellite owner pubkey. Defaults to SOLANA_AUTHORITY_KEYPAIR's own pubkey.
OWNER_PUBKEY=

# These three default to the real production WorldIDSatellite (EVM) values
# so a Solana satellite bridging real World Chain state stays semantically
# consistent with the other chains. Only override if you know why.
ROOT_VALIDITY_WINDOW=3600
TREE_DEPTH=30
MIN_EXPIRATION_THRESHOLD=18000

# ---------------------------------------------------------------------------
# add-gateway (run once per relay operator; safe to re-run)
# ---------------------------------------------------------------------------

# Pubkey of the gateway signer to authorize (the relay's Solana keypair).
# Leave unset to skip this step (e.g. if you're only deploying/upgrading the
# program and will authorize gateways separately).
GATEWAY_PUBKEY=
